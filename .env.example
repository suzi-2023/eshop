# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# On Vercel, add the same keys under Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon or Supabase free tier both work).
# For Neon use the *pooled* connection string so serverless functions don't
# exhaust connections. Leave empty to run the UI against the bundled demo catalog.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Anthropic API key for the AI features (search, assistant, descriptions).
# Not used yet by the scaffold; wired in a later step.
ANTHROPIC_API_KEY=""

# Public site settings (safe to expose to the browser).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: override the models used by the AI features (defaults shown).
# AI_SEARCH_MODEL="claude-haiku-5-5"
# AI_ASSISTANT_MODEL="claude-sonnet-5-5"
