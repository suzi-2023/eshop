# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# On Vercel, add the same keys under Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon or Supabase free tier both work).
# For Neon use the *pooled* connection string so serverless functions don't
# exhaust connections. Leave empty to run the UI against the bundled demo catalog.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- AI features (search + shopping assistant) -----------------------------
# Set ONE of these keys. With neither, the AI features stay in preview mode.
#
# Google Gemini: free tier, get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
# Anthropic Claude: pay as you go, get a key at https://platform.claude.com
ANTHROPIC_API_KEY=""

# Optional: force a provider when both keys are set ("gemini" or "claude").
# AI_PROVIDER="gemini"

# Optional: override the models (defaults depend on the provider, see
# src/lib/ai/config.ts). Examples:
# AI_SEARCH_MODEL="gemini-3.5-flash-lite"
# AI_ASSISTANT_MODEL="gemini-3.5-flash"

# Public site settings (safe to expose to the browser).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
